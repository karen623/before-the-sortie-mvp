# 複製這個檔案並改名成 .env，再填入你的金鑰（.env 不會被上傳到 GitHub）
GROQ_API_KEY=請貼上你的金鑰
MODEL=openai/gpt-oss-120b
BASE_URL=https://api.groq.com/openai/v1
TEMPERATURE=0.8

# 長期記憶的 embedding 模型：e5（語意，需安裝 sentence-transformers）或 simple（只比對字面）
EMBEDDER=e5

# 設成 1 可以不用金鑰、用假的 AI 回應測試流程
MOCK=0

# 之後想改用本機 Ollama 時：
# BASE_URL=http://localhost:11434/v1
# MODEL=gemma3:12b
# GROQ_API_KEY=ollama
